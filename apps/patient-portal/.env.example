# URL base de la API de Salud Digna, con el prefijo /api/v1.
# Solo la lee el servidor de Next: no lleva el prefijo NEXT_PUBLIC_.
# Debe usar https, salvo en localhost y 127.0.0.1.
API_BASE_URL=https://api.salud-digna.app/api/v1

# Servicio que registra los trámites. Solo la lee el servidor.
# legacy, por defecto: operaciones /requests de la API general.
# orchestrator: orquestador. Exige las dos variables siguientes.
REQUESTS_BACKEND=

# URL base del orquestador, con el prefijo /api/v1. Solo la lee el servidor.
# Debe usar https, salvo en localhost y 127.0.0.1.
ORCHESTRATOR_BASE_URL=

# Clave del canal Web en el orquestador, con la forma <keyId>.<secret> y sin el prefijo Bearer.
# Necesita los scopes EVENTS_PUBLISH y JOURNEYS_READ. Solo la lee el servidor.
# Es un secreto: va en .env.local, nunca en Git.
ORCHESTRATOR_CHANNEL_KEY=

# Carpeta del registro del canal Web, que solo se usa con el orquestador.
# Por defecto, .data dentro del portal, ignorada por Git.
PORTAL_DATA_DIR=
