# URL base de la API de Salud Digna, con el prefijo /api/v1.
# Solo la lee el servidor de Next: no lleva el prefijo NEXT_PUBLIC_.
# Debe usar https, salvo en localhost y 127.0.0.1.
API_BASE_URL=https://api.salud-digna.app/api/v1

# Servicio que registra los trámites. Solo la lee el servidor.
# legacy, por defecto: operaciones /requests de la API general.
# orchestrator: orquestador. Exige las dos variables siguientes.
REQUESTS_BACKEND=

# URL base del orquestador, con el prefijo /api/v1. Solo la lee el servidor.
# Debe usar https, salvo en localhost y 127.0.0.1.
ORCHESTRATOR_BASE_URL=

# Clave del canal Web en el orquestador, con la forma <keyId>.<secret> y sin el prefijo Bearer.
# Necesita los scopes EVENTS_PUBLISH y JOURNEYS_READ. Solo la lee el servidor.
# Es un secreto: va en .env.local, nunca en Git.
ORCHESTRATOR_API_KEY=

# Carpeta del registro del canal Web, que solo se usa con el orquestador.
# Por defecto, .data dentro del portal, ignorada por Git.
PORTAL_DATA_DIR=

# Registro de cuentas nuevas. Solo la lee el servidor. Admite true o false.
# Sin valor: apagado en producción y encendido en desarrollo.
# Apagado, /registro no existe y el portal rechaza cualquier envío de registro.
REGISTRATION_ENABLED=

# Envía a la API general la IP del paciente, en la cabecera X-Portal-Client-IP. Admite true o false.
# Apagada por defecto. No la enciendas hasta que el equipo de la API confirme que confía en esa
# cabecera solo cuando la petición viene del servidor del portal.
FORWARD_CLIENT_IP=

# Identidad del paciente ante el orquestador. Solo la lee el servidor. Admite none o assertion.
# none, por defecto: sin acreditación; el portal recuerda los trámites en su registro del canal Web.
# assertion: cada trámite se crea y se consulta con la acreditación institucional del paciente.
# Exige REQUESTS_BACKEND=orchestrator. Si no hay acreditación, no se crea nada.
PATIENT_IDENTITY_MODE=

# Credencial del canal Web ante el emisor de acreditaciones de la API central (docs/api-patient-assertions.md):
# 32 bytes en base64url, sin relleno. Distinta de ORCHESTRATOR_API_KEY. Secreto. Obligatoria con assertion.
PATIENT_ASSERTION_CHANNEL_KEY=

# Segundos que dura en caché el catálogo (/, /estudios, /clinicas y /estudios/<id>), de 1 a 86400.
# Se lee al compilar: cambiarla exige volver a compilar. Sin valor, 300.
CATALOG_CACHE_SECONDS=
