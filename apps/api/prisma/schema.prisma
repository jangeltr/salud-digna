generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  WEB
  WHATSAPP
  MOBILE
  CALL_CENTER
}

enum UserRole {
  PATIENT
  ADVISOR
  ADMIN
}

enum ServiceRequestType {
  APPOINTMENT
}

enum ServiceRequestStatus {
  DRAFT
  IN_PROGRESS
  PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Patient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  identities    PatientIdentity[]
  identityLinks IdentityLink[]
  user          User?
  requests      ServiceRequest[]
}

model PatientIdentity {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId  String    @db.Uuid
  provider   Channel
  externalId String
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([patientId])
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String?
  role         UserRole
  patientId    String?  @unique @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  interactions Interaction[]
  domainEvents DomainEvent[]
  auditLogs    AuditLog[]
  assistanceAuthorizations AssistanceAuthorization[]
}

model Clinic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String
  city      String
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]
}

model Study {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]
}

model ServiceRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String               @db.Uuid
  type        ServiceRequestType
  status      ServiceRequestStatus @default(DRAFT)
  currentStep String
  lastChannel Channel
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  completedAt DateTime?            @db.Timestamptz(3)

  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  context      RequestContext?
  interactions Interaction[]
  domainEvents DomainEvent[]
  appointment  Appointment?
  assistanceAuthorizations AssistanceAuthorization[]

  @@unique([id, patientId])
  @@index([patientId, createdAt])
}

model RequestContext {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String   @unique @db.Uuid
  data      Json     @default("{}") @db.JsonB
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
}

model Interaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String   @db.Uuid
  patientId   String   @db.Uuid
  channel     Channel
  actorUserId String?  @db.Uuid
  type        String
  content     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId, patientId], references: [id, patientId], onDelete: Restrict)
  actor   User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id])
}

model DomainEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String   @db.Uuid
  patientId   String   @db.Uuid
  type        String
  channel     Channel
  actorUserId String?  @db.Uuid
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId, patientId], references: [id, patientId], onDelete: Restrict)
  actor   User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id])
}

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String            @unique @db.Uuid
  patientId   String            @db.Uuid
  clinicId    String            @db.Uuid
  studyId     String            @db.Uuid
  scheduledAt DateTime          @db.Timestamptz(3)
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId, patientId], references: [id, patientId], onDelete: Restrict)
  clinic  Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study   Study          @relation(fields: [studyId], references: [id], onDelete: Restrict)

  @@unique([requestId, patientId])
  @@index([clinicId, scheduledAt])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}

model IdentityLink {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId  String    @db.Uuid
  provider   Channel
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
}

model AssistanceAuthorization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String    @db.Uuid
  codeHash        String    @unique @db.Char(64)
  codeExpiresAt   DateTime  @db.Timestamptz(3)
  claimedAt       DateTime? @db.Timestamptz(3)
  advisorId       String?   @db.Uuid
  accessExpiresAt DateTime? @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  advisor User?          @relation(fields: [advisorId], references: [id], onDelete: Restrict)

  @@index([requestId, advisorId, accessExpiresAt])
}

enum WhatsAppInboxStatus {
  PENDING
  PREPARING
  READY
  SENDING
  SENT
  FAILED
}

model WhatsAppInbox {
  providerMessageId String               @id
  phoneNumberId     String
  sender            String?
  receivedAt        DateTime             @db.Timestamptz(3)
  input             Json?                @db.JsonB
  reply             String?
  status            WhatsAppInboxStatus  @default(PENDING)
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now()) @db.Timestamptz(3)
  outboundMessageId String?
  lastError         String?

  @@index([phoneNumberId, status, nextAttemptAt])
}
