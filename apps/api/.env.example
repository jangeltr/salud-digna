NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Configura manualmente una URL válida en .env.
# postgresql://salud_digna_app:<PASSWORD>@127.0.0.1:5432/salud_digna?schema=public
DATABASE_URL=
# Únicamente para migraciones de desarrollo con una base auxiliar dedicada.
# SHADOW_DATABASE_URL=

# Genera un secreto aleatorio con: openssl rand -hex 32
JWT_SECRET=
# Vigencia del token en segundos.
JWT_EXPIRES_IN=1800

# Activa únicamente para probar identidades sintéticas en desarrollo.
IDENTITY_SIMULATOR_ENABLED=false

# Activa únicamente el simulador de conversaciones en desarrollo.
CONVERSATION_SIMULATOR_ENABLED=false

# Interpretación opcional mediante Responses API.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=8000
