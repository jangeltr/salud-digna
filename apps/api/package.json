{
  "name": "@salud-digna/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm run prisma:generate && nest start --watch",
    "build": "pnpm run prisma:generate && tsc",
    "start": "node dist/main.js",
    "check": "pnpm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "auth:create-admin": "node dist/auth/create-admin.js",
    "catalogs:seed-demo": "node dist/catalogs/seed-demo.js",
    "test:whatsapp": "pnpm run build && node --test --test-isolation=none test/whatsapp-providers.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "openai": "7.62.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "24.19.2",
    "prisma": "7.9.1",
    "typescript": "5.9.3"
  }
}
