{
  "name": "@salud-digna/orchestrator",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm run prisma:generate && nest start --watch",
    "build": "pnpm run prisma:generate && tsc",
    "start": "node dist/main.js",
    "check": "pnpm run prisma:generate && tsc --noEmit",
    "auth:create-channel-credential": "node dist/channel-auth/create-channel-credential.js",
    "auth:create-demo-journey-grant": "node dist/journey-access/create-demo-journey-grant.js",
    "auth:provision-demo-patient": "node dist/journeys/provision-demo-patient.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "24.19.2",
    "prisma": "7.9.1",
    "typescript": "5.9.3"
  }
}
